@startuml class
' Class Diagram - COLORS Web Application (COP 4331 LAMP Stack, Labs 1-3)
' The app is procedural (JS + PHP scripts), so pages, scripts and endpoints are
' modeled as stereotyped classes; <<JSON>> classes show the messages exchanged
' over HTTP. Layout is top-down: Client -> Server -> Database.
title COLORS Web Application - Class Diagram
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 70
skinparam class {
  BackgroundColor #F5F9FF
  BorderColor #3A6EA5
}
hide empty members

package "Client (public/)" {
  class "index.html" as IndexPage <<HTML Page>> {
    - loginName : text input
    - loginPassword : password input
    - loginButton : button
    - loginResult : span
  }

  class "color.html" as ColorPage <<HTML Page>> {
    - userName : span
    - logoutButton : button
    - searchText : text input
    - searchColorButton : button
    - colorSearchResult : span
    - colorList : p
    - colorText : text input
    - addColorButton : button
    - colorAddResult : span
  }

  class "md5.js" as MD5 <<JavaScript Library>> {
    + md5(text : string) : string
  }

  class "code.js" as CodeJS <<JavaScript Module>> {
    + {static} urlBase : string = "LAMPAPI"
    + {static} extension : string = "php"
    - userId : int
    - firstName : string
    - lastName : string
    --
    + doLogin() : void
    + doLogout() : void
    + addColor() : void
    + searchColor() : void
    - saveCookie() : void
    - readCookie() : void
  }

  class SessionCookie <<Cookie>> {
    firstName : string
    lastName : string
    userId : int
    expires : Date = now + 20 min
  }
}

package "Server (api/ - PHP)" {
  class "config.php" as Config <<PHP Config>> {
    + DB_HOST : string
    + DB_USER : string
    + DB_PASS : string
    + DB_NAME : string = "COP4331"
  }

  class "db.php" as DbHelpers <<PHP Helpers (required by every endpoint)>> {
    + getDbConnection() : mysqli
    + getRequestInfo() : array
    + sendResultInfoAsJson(obj : string) : void
  }

  class "Login.php" as LoginAPI <<Endpoint>> {
    - returnWithError(err : string) : void
    - returnWithInfo(firstName, lastName, id) : void
  }
  class "AddColor.php" as AddColorAPI <<Endpoint>> {
    - returnWithError(err : string) : void
  }
  class "SearchColors.php" as SearchAPI <<Endpoint>> {
    - searchCount : int
    - returnWithError(err : string) : void
    - returnWithInfo(searchResults : string) : void
  }

  class LoginRequest <<JSON>> {
    login : string
    password : string
  }
  class LoginResponse <<JSON>> {
    id : int
    firstName : string
    lastName : string
    error : string
  }
  class AddColorRequest <<JSON>> {
    color : string
    userId : int
  }
  class ErrorResponse <<JSON>> {
    error : string
  }
  class SearchRequest <<JSON>> {
    search : string
    userId : int
  }
  class SearchResponse <<JSON>> {
    results : string[]
    error : string
  }
}

package "Database (MySQL: COP4331)" {
  entity Users <<table>> {
    * ID : INT <<PK>> AUTO_INCREMENT
    --
    DateCreated : DATETIME
    DateLastLoggedIn : DATETIME
    FirstName : VARCHAR(50)
    LastName : VARCHAR(50)
    Login : VARCHAR(50)
    Password : VARCHAR(50)
  }
  entity Colors <<table>> {
    * ID : INT <<PK>> AUTO_INCREMENT
    --
    Name : VARCHAR(50)
    UserID : INT
  }
}

' --- Client: pages load scripts; code.js keeps the session in a cookie
IndexPage .down.> CodeJS : loads
ColorPage .down.> CodeJS : loads
IndexPage .down.> MD5 : loads
CodeJS .left.> MD5 : <<optional>>
CodeJS -right-> SessionCookie : saves / reads

' --- HTTP calls (XMLHttpRequest POST)
CodeJS .down.> LoginAPI : POST
CodeJS .down.> AddColorAPI : POST
CodeJS .down.> SearchAPI : POST

' --- Layout only: fix left-to-right order of the endpoint row and the row
' below it, and keep the Database package underneath the Server package
LoginAPI -[hidden]right- AddColorAPI
AddColorAPI -[hidden]right- SearchAPI
LoginRequest -[hidden]right- LoginResponse
LoginResponse -[hidden]right- AddColorRequest
AddColorRequest -[hidden]right- DbHelpers
Config -[hidden]right- ErrorResponse
ErrorResponse -[hidden]right- SearchRequest
SearchRequest -[hidden]right- SearchResponse
LoginRequest -[hidden]down- Users
SearchResponse -[hidden]down- Colors

' --- Every endpoint does require_once "db.php", which requires config.php
LoginAPI ..> DbHelpers
AddColorAPI ..> DbHelpers
SearchAPI ..> DbHelpers
DbHelpers .right.> Config

' --- JSON messages each endpoint receives / returns
LoginAPI .down.> LoginRequest
LoginAPI .down.> LoginResponse
AddColorAPI .down.> AddColorRequest
AddColorAPI .down.> ErrorResponse
SearchAPI .down.> ErrorResponse
SearchAPI .down.> SearchRequest
SearchAPI .down.> SearchResponse

' --- Data access (mysqli prepared statements)
LoginAPI .down.> Users : SELECT
AddColorAPI .down.> Colors : INSERT
SearchAPI .down.> Colors : SELECT ... LIKE

Users "1" -right- "0..*" Colors : owns >
@enduml
