@startuml usecase
' Use Case Diagram - COLORS Web Application (COP 4331 LAMP Stack, Labs 1-3)
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F5F9FF
  BorderColor #3A6EA5
}
title COLORS Web Application - Use Case Diagram

actor "User" as User
actor "MySQL Database\n(COP4331)" as DB <<system>>

rectangle "COLORS Web Application" {
  usecase "Log In" as UC_Login
  usecase "Authenticate\nCredentials" as UC_Auth
  usecase "Show Login Error" as UC_LoginErr
  usecase "Start Session\n(save cookie, 20 min)" as UC_Session
  usecase "Verify Session\n(read cookie)" as UC_Verify
  usecase "Search Colors" as UC_Search
  usecase "Add Color" as UC_Add
  usecase "Log Out" as UC_Logout

  UC_Login ..> UC_Auth : <<include>>
  UC_Login ..> UC_Session : <<include>>
  UC_LoginErr ..> UC_Login : <<extend>>\n[id < 1]
  UC_Search ..> UC_Verify : <<include>>
  UC_Add ..> UC_Verify : <<include>>
}

User --> UC_Login
User --> UC_Search
User --> UC_Add
User --> UC_Logout

UC_Auth --> DB
UC_Search --> DB
UC_Add --> DB

note right of UC_Search
  Partial (substring) match
  (LIKE '%text%') limited to the
  logged-in user's colors
end note

note right of UC_Verify
  On color.html load: if no valid
  userId cookie, redirect to index.html
end note
@enduml
